<Window x:Class="RelentlessEye.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relentless Eye" Icon="/RelentlessEye;component/RelentlessEye.ico" Height="960" Width="1640" MinWidth="640" MinHeight="400"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Top bar: the hub connection; click it to open its settings underneath -->
        <Border DockPanel.Dock="Top" Background="#1a1d23" BorderBrush="{StaticResource CardEdge}" BorderThickness="0,0,0,1" Padding="14,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="Relentless Eye" FontSize="15" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="HubToggle" Checked="HubToggle_Checked" Unchecked="HubToggle_Unchecked"
                                  ToolTip="The hub this monitor shows: click to change it">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="6,3" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="chev" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource Dim}" StrokeThickness="1.5"
                                              VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#262a32"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="chev" Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HubDot" Width="9" Height="9" Fill="{StaticResource Track}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HubText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Hub settings: open while the toggle is; closing it drops what was typed -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="26,10,0,6" KeyDown="SettingsPanel_KeyDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Hub" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="HubBox" Grid.Column="1" VerticalAlignment="Center" TextChanged="HubBox_TextChanged"/>
                    <TextBlock Grid.Column="2" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                               Text="host[:port]. This machine is localhost:47800; for another machine, use its name or IP."/>

                    <TextBlock x:Name="TokenLabel" Grid.Row="1" Text="Token" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,8,10,0"/>
                    <PasswordBox x:Name="TokenBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TokenHint" Grid.Row="1" Grid.Column="2" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,8,0,0" TextWrapping="Wrap"/>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Connect" IsDefault="True" Click="ApplySettings_Click"/>
                        <Button Content="Use this machine" Margin="8,0,0,0" Click="LocalHub_Click"
                                ToolTip="Fill in localhost:47800, the hub on this machine"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App list -->
            <DockPanel Background="#181a20">
                <TextBlock DockPanel.Dock="Top" x:Name="AppCount" Margin="14,10,14,6" Foreground="{StaticResource Dim}" FontSize="11"/>
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" SelectionChanged="AppList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,7"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#20242b"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#252a33"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource CardEdge}" HorizontalAlignment="Stretch"/>

            <!-- Selected app -->
            <DockPanel Grid.Column="2">
                <Border x:Name="AppHeader" DockPanel.Dock="Top" Padding="16,12,16,4" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="ForgetButton" DockPanel.Dock="Right" Content="Forget" VerticalAlignment="Top"
                                ToolTip="Drop this offline app's panel from the hub" Click="ForgetButton_Click"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AppTitle" FontSize="19" FontWeight="SemiBold"/>
                                <Border x:Name="OfflineBadge" Background="#3a2a1a" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="offline" Foreground="#f59e0b" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="AppSub" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                    <ScrollViewer x:Name="PanelHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="420"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
