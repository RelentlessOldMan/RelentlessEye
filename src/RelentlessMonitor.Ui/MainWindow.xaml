<Window x:Class="RelentlessMonitor.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelentlessMonitor" Height="760" Width="1180" MinWidth="640" MinHeight="400"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Top bar: hub connection -->
        <Border DockPanel.Dock="Top" Background="#1a1d23" BorderBrush="{StaticResource CardEdge}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Hub settings" Click="SettingsButton_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RelentlessMonitor" FontSize="15" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <Ellipse x:Name="HubDot" Width="9" Height="9" Fill="{StaticResource Track}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HubText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hub settings (hidden until asked for) -->
        <Border x:Name="SettingsPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#1a1d23"
                BorderBrush="{StaticResource CardEdge}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hub" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Dim}"/>
                <TextBox x:Name="HubBox" Width="220" VerticalAlignment="Center" ToolTip="host[:port] — empty means this machine, port 47800"/>
                <TextBlock Text="Token" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Dim}"/>
                <PasswordBox x:Name="TokenBox" Width="260" VerticalAlignment="Center" ToolTip="Only for a hub on another machine: the token in its hub.json"/>
                <Button Content="Connect" Margin="16,0,0,0" Click="ApplySettings_Click"/>
                <Button Content="Cancel" Margin="8,0,0,0" Click="CancelSettings_Click"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App list -->
            <DockPanel Background="#181a20">
                <TextBlock DockPanel.Dock="Top" x:Name="AppCount" Margin="14,10,14,6" Foreground="{StaticResource Dim}" FontSize="11"/>
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" SelectionChanged="AppList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,7"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#20242b"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#252a33"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource CardEdge}" HorizontalAlignment="Stretch"/>

            <!-- Selected app -->
            <DockPanel Grid.Column="2">
                <Border x:Name="AppHeader" DockPanel.Dock="Top" Padding="16,12,16,4" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="ForgetButton" DockPanel.Dock="Right" Content="Forget" VerticalAlignment="Top"
                                ToolTip="Drop this offline app's panel from the hub" Click="ForgetButton_Click"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AppTitle" FontSize="19" FontWeight="SemiBold"/>
                                <Border x:Name="OfflineBadge" Background="#3a2a1a" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="offline" Foreground="#f59e0b" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="AppSub" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                    <ScrollViewer x:Name="PanelHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="420"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
