<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RelentlessEye</RootNamespace>
    <PackageId>RelentlessEye.Client</PackageId>
    <Description>Feed a RelentlessEye hub: describe your app's monitor panel, push values, answer actions and requests. Never blocks; silent when no hub is running.</Description>
    <PackageTags>monitor;dashboard;status</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RelentlessEye.Tests" />
  </ItemGroup>
</Project>
