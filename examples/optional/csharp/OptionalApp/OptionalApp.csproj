<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Deliberately NO reference to RelentlessMonitor.Client: MonitorBridge.cs finds the DLL at runtime
       (next to the exe, %RELENTLESSMONITOR_CLIENT%, or %LOCALAPPDATA%\RelentlessMonitor\client) and
       does nothing when it isn't there. -->
</Project>
